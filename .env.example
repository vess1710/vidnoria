# ============================================================================
# Vidnoria Environment Configuration Example
# Copy this file to .env.local for development or .env for production
# ============================================================================

# --- Admin Security ---
# Secret password used to access the /admin dashboard
ADMIN_PASSWORD=ChangeThisToAStrongSecretPassword2026!

# Cryptographic secret used to sign session cookies (HMAC SHA-256)
ADMIN_SECRET=generate-a-random-64-character-string-here-for-production

# --- Site URL & SEO ---
NEXT_PUBLIC_SITE_URL=https://vidnoria.com

# --- Analytics (Optional) ---
# Google Analytics 4 Measurement ID (leave empty if not configured yet)
GA4_MEASUREMENT_ID=

# --- Server Port ---
PORT=3000
